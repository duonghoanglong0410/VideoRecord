# ==============================================================================
# PackingProof Web — Ví dụ Cấu hình Biến Môi trường (.env.example)
# Lưu ý: Không đưa mật khẩu thật hoặc khóa bí mật vào source control!
# Sao chép thành file .env và điền giá trị thực tế khi chạy.
# ==============================================================================

# 1. Ứng dụng & Xác thực
APP_PUBLIC_ORIGIN=http://localhost:5173
AUTH_COOKIE_NAME=PackingProof.Auth
DATA_PROTECTION_KEYS_PATH=./.local-data/dataprotection-keys

# 2. Cơ sở dữ liệu PostgreSQL (ví dụ kết nối dịch vụ postgresql-x64-18 local)
DATABASE_CONNECTION=Host=localhost;Port=5432;Database=packingproof_dev;Username=postgres;Password=CHANGE_ME_LOCAL_DB_PASSWORD

# 3. Chế độ lưu trữ Video: LocalDevelopment | SynologyMounted
STORAGE_MODE=LocalDevelopment
# Đường dẫn thư mục gốc lưu trữ (Local folder khi dev, hoặc mount point / UNC share khi SynologyMounted)
NAS_ROOT_PATH=./.local-data/storage
# Định danh bắt buộc khớp với nội dung file .packingproof-storage-id trên share khi chạy SynologyMounted
STORAGE_ID=packingproof-local-dev-storage-01
# Vùng đệm nhận upload tus bền vững trên máy chủ (luôn đặt trên ổ đĩa cục bộ tốc độ cao)
STAGING_ROOT_PATH=./.local-data/staging
# Bật true nếu tài khoản SMB trên NAS chỉ có quyền ghi mới/đọc (Write-Once / Append-Only, không cho xóa/đổi tên)
NAS_WRITE_ONCE_MODE=false
# Tài khoản SMB tùy chọn trên Windows để tự động kết nối lại UNC share (để trống nếu mount ở mức OS; không commit mật khẩu thật)
NAS_SMB_USERNAME=
NAS_SMB_PASSWORD=

# 4. Giới hạn Quay, Upload & Xử lý nền
MAX_RECORDING_SECONDS=600
MAX_UPLOAD_BYTES=536870912
MAX_LOCAL_PENDING_RECORDINGS=3
UPLOAD_CHUNK_BYTES=5242880
STAGING_MAX_BYTES=10737418240
PROCESSING_CONCURRENCY=2
ENABLE_AUDIO_RECORDING=false

# 5. Chính sách tự động dọn dẹp theo thời hạn (Mặc định TẮT)
RETENTION_ENABLED=false
RETENTION_DAYS=90

# 6. Bootstrap tài khoản SuperAdmin đầu tiên (Chỉ chạy khi hệ thống chưa có SuperAdmin nào)
# Bắt buộc đổi giá trị thật trong biến môi trường khi khởi chạy lần đầu; để trống nếu đã khởi tạo.
INITIAL_ADMIN_EMAIL=admin@example.local
INITIAL_ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_RUN_StrongPass!2026

# 7. Công cụ Media (Mặc định gọi trong PATH hệ thống)
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

# 8. Cấu hình SMTP đặt lại mật khẩu (Tùy chọn — nếu để trống, sử dụng luồng Admin khởi tạo đặt lại có kiểm soát)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.local

